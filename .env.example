# =====================================================================
#  AI GTM OS - Environment Configuration (DRAFT)
#  Copy to `.env` and fill in only what you actually connect.
#  Every connector is OPTIONAL: if a key is blank the platform runs that
#  provider in SIMULATION mode so the whole system stays demoable.
# =====================================================================


# ---------------------------------------------------------------------
# 1. CORE PLATFORM
# ---------------------------------------------------------------------
DJANGO_SECRET_KEY=change-me-to-a-long-random-string
DJANGO_DEBUG=true
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
# Frontend origin(s) allowed to call the API
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
# Leave blank for SQLite. Postgres example: postgres://user:pass@localhost:5432/gtm
DATABASE_URL=
# Redis (optional - enables Celery background agent runs). Blank = run agents inline.
REDIS_URL=
# Public URLs (used in generated links, OAuth callbacks, tracking pixels)
PUBLIC_APP_URL=http://localhost:5173
PUBLIC_API_URL=http://localhost:8000
# JWT lifetimes
JWT_ACCESS_MINUTES=60
JWT_REFRESH_DAYS=14
# Field-level encryption key for stored connector credentials (Fernet key).
# Generate: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
CREDENTIALS_ENCRYPTION_KEY=


# ---------------------------------------------------------------------
# 2. AI / LLM PROVIDER  (the brain of every agent)
# ---------------------------------------------------------------------
# Which vendor the agents reason through: groq | anthropic | openai
LLM_PROVIDER=groq

# --- GROQ (primary) ---------------------------------------------------
# Get a key: https://console.groq.com/keys  (free tier available, rate-limited)
GROQ_API_KEY=
# Reasoning model - AI CMO, ICP derivation, strategy, decision cards
GROQ_MODEL=openai/gpt-oss-120b
# Cheap/fast worker - bulk personalisation (10k prospects), reply classification
GROQ_WORKER_MODEL=openai/gpt-oss-20b
#
# Model IDs on Groq change often. List what your key can actually use:
#   curl https://api.groq.com/openai/v1/models -H "Authorization: Bearer $GROQ_API_KEY"
# Options to try for GROQ_MODEL (verify against the curl above - Groq retires IDs):
#   openai/gpt-oss-120b                  strongest reasoning here; good default
#   openai/gpt-oss-20b                   faster + cheaper; fine as the worker
#   qwen/qwen3.8-27b                     reasoning model (emits <think>, auto-stripped)
#   groq/compound                        agentic model with built-in tools
#
# blank = https://api.groq.com (override for a proxy)
GROQ_BASE_URL=
GROQ_TEMPERATURE=0.6
GROQ_MAX_RETRIES=5                      # free tier is rate-limited; SDK backs off automatically
GROQ_TIMEOUT=120
GROQ_SEND_REASONING_EFFORT=false        # only some Groq models accept reasoning_effort

# --- Optional alternatives (only used if LLM_PROVIDER points at them) --
# pip install anthropic
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-opus-5
ANTHROPIC_WORKER_MODEL=claude-sonnet-5
# pip install openai  (also works for any OpenAI-compatible gateway via OPENAI_BASE_URL)
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4.1
OPENAI_WORKER_MODEL=gpt-4.1-mini
OPENAI_BASE_URL=
GOOGLE_GEMINI_API_KEY=
# Embeddings / vector store for Marketing Memory + Knowledge Graph search
EMBEDDINGS_PROVIDER=voyage              # voyage | openai
VOYAGE_API_KEY=
PINECONE_API_KEY=
PINECONE_INDEX=gtm-memory
# Generative image / video / voice for AI Creative Director + AI Video Agent
HIGGSFIELD_API_KEY=
RUNWAY_API_KEY=
ELEVENLABS_API_KEY=
STABILITY_API_KEY=
FAL_API_KEY=


# ---------------------------------------------------------------------
